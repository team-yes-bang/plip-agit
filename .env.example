# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8083
MYSQL_PORT=3308

# MySQL 스키마명 — 서비스별로 변경 (예: plip_agit)
MYSQL_DATABASE=plip_agit

# Kafka (user / develop-env 공통). Docker 네트워크에서는 kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Mongo replica set rs0 (Docker 네트워크에서는 mongo:27017). develop-env 복사 시 동일 URI 호스트 `mongo`
MONGODB_URI=mongodb://localhost:27017/plip_agit?replicaSet=rs0
MONGODB_PORT=27017

# 기동 시 MySQL → Mongo 읽기 모델 백필. 기본 비활성
AGIT_MONGO_BACKFILL=false

# 멤버십 가드 Hash `agit:{agitUuid}:members` (HOST|GUEST). topic과 같은 Redis를 쓴다.
# topic은 이 키를 읽기만 한다. 게이트웨이에 GET /internal/v1/agits/{uuid}/members 를 올리지 않는다.
REDIS_HOST=localhost
REDIS_PORT=6379

# docker-compose.with-user.yml 의 user 컨테이너는 자체 JWT를 쓴다. agit는 Gateway X-User-UUID만 신뢰한다.
# JWT_SECRET=change-me-local-dev-only

# AWS S3 (썸네일 Presigned PUT — raw bucket images/agit/*). 로컬 NoOp stub은 AWS_ENABLED=false
AWS_ENABLED=false
AWS_REGION=ap-northeast-2
AWS_S3_RAW_BUCKET=
AWS_CDN_BASE_URL=
AWS_PRESIGNED_URL_TTL_SECONDS=10800

# docker-compose.with-user.yml — user 앱 호스트 포트 / redis 호스트 노출
# up:   docker compose -f docker-compose.with-user.yml up -d --build
# down: docker compose -f docker-compose.with-user.yml down
# user API: http://localhost:${USER_SERVER_PORT:-8080}
# 기존 MySQL 볼륨이 있으면 plip_user 는 수동 CREATE DATABASE 또는 down -v
USER_SERVER_PORT=8080
REDIS_PORT=6379

# user OTP 메일 (JavaMailSender 기동용). 실제 발송 시 plip-user .env 의 MAIL_* 를 복사
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
